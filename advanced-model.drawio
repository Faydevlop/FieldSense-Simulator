  <diagram id="advanced-model-flow" name="Advanced Model Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Advanced Simulation Engine Flow&#xa;(isAdvanced = true)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Input per run/day&#xa;- water, sunlight, soilMoisture, humidity, temperature, fertilizerLevel, soilType&#xa;- uncertaintyEnabled, intensity, optional seed&#xa;- plantType (growthRate, stressThreshold, ideals)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Rule Config JSON (configurable)&#xa;advancedRules.json&#xa;Each rule:&#xa;id, priority, probability, conditions, effects, note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Rule processing each day&#xa;1) Find rules matching current controls&#xa;2) Apply probability check (if rule chance &lt; 100%)&#xa;3) Add all matched effects together&#xa;(health, growth, stress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="940" y="90" width="370" height="190" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Hardcoded values in code&#xa;- Start health: 100&#xa;- Start stress: 20&#xa;- Dead if health is below 20&#xa;- Stress starts reducing health after 60&#xa;- Stress starts reducing growth after 70&#xa;- Uncertainty intensity max: 0.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1340" y="80" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Daily update (simple)&#xa;1) Start from yesterday values&#xa;2) Apply combined rule effects&#xa;3) Apply extra penalty if stress is high&#xa;4) Keep values in safe range&#xa;5) Decide state: healthy / stressed / dead&#xa;6) Save which rules were applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="940" y="330" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Time-step progression&#xa;- append day state to timeline&#xa;- use previous state as base for next day&#xa;- stop early if dead&#xa;- keep randomState for deterministic replay with seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Scenario Lab outputs&#xa;- save/list scenarios&#xa;- compare side-by-side timelines&#xa;- export CSV&#xa;- show latest state + trends in UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="940" y="560" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Configurable: rule JSON (conditions, effects, probabilities).&#xa;Hardcoded: baseline thresholds and stress penalties." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1" vertex="1" parent="1">
