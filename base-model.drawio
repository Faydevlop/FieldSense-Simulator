<mxfile host="app.diagrams.net" modified="2026-05-05T16:15:00.000Z" agent="codex" version="24.7.17" type="device">
  <diagram id="base-model-flow" name="Base Model Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Base Simulation Engine Flow&#xa;(isAdvanced = false)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Input per run/day&#xa;- water (low/medium/high)&#xa;- sunlight (low/medium/high)&#xa;- plantType (idealWater, idealSunlight, growthRate, stressThreshold)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Compare inputs with plant ideal&#xa;- Match: same as ideal&#xa;- Mismatch: different from ideal&#xa;Example: Medium water + Medium sunlight = 2 matches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Hardcoded numbers in code&#xa;- Health: +2 per match, -12 per mismatch&#xa;- Growth: +0.35 per match, -0.3 per mismatch&#xa;- Start health: 100&#xa;- Dead if health is below 20&#xa;- Health always clamped between 0 and 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Daily update (simple)&#xa;1) Start from yesterday health/growth&#xa;2) Add or subtract health using the health rule&#xa;3) Calculate growth increase from growthRate&#xa;4) Never allow negative growth&#xa;5) If plant is dead, growth does not increase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Resolve plant state&#xa;if health below 20 -> dead&#xa;else if health below stressThreshold -> stressed&#xa;else healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="880" y="310" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Time-step loop (Day 1 -> Day N)&#xa;- append state to timeline each day&#xa;- use previous day state as base for next day&#xa;- stop early if state = dead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Output to API/UI&#xa;- currentDay&#xa;- latestState (growth, health, state)&#xa;- full timeline for chart/log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Configurable by payload (not hardcoded):&#xa;water/sunlight inputs + plantType values." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#3a7" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
